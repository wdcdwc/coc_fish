# 复制成 .env 后填写真实值，然后导出到当前 shell：
#   set -a && source .env && set +a
# .env 已被 .gitignore 忽略，不要提交。

# ---- JWT 签名密钥（房间模式必填，随机长字符串）----
COC_JWT_SECRET_KEY=

# ---- PostgreSQL 连接串（房间模式必填，单机打鱼可留空）----
# 建表：createdb coc && psql -d coc -f schema.sql
COC_DATABASE_URL=

# ---- Redis（单机打鱼和房间模式都必填）----
COC_REDIS_HOST=127.0.0.1
COC_REDIS_PORT=6379
COC_REDIS_DB=0

# ---- 邮件通知（可选，留空则发件相关功能不可用）----
COC_MAIL_SENDER=
COC_MAIL_AUTH_CODE=
COC_SMTP_HOST=smtp.qq.com
COC_SMTP_PORT=465

# ---- 云手机厂商开放平台密钥（可选，仅房间模式开通云手机时用到）----
COC_CLOUD_PHONE_ACCESS_KEY_ID=
COC_CLOUD_PHONE_ACCESS_KEY_SECRET=

# ---- 后端对外域名（可选，邮件里的跳转链接）----
COC_BACK_END_DOMAIN=
